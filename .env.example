# API Keys para Guion-Gen
# Obtén tu API KEY permanente de Google AI Studio en: https://aistudio.google.com/apikey
# IMPORTANTE: Debe ser una API Key (empieza con AIzaSy...), NO un OAuth2 token (AQ.*)
# Los tokens OAuth2 expiran en 1 hora y causarán error 401.
GOOGLE_GEMINI_API_KEY=AIzaSy_tu_api_key_permanente_aqui

# Obtén tu key de Groq en: https://console.groq.com/keys
# El modelo de texto activo se configura en src/config/settings.py → MODELS["groq"]["text"]
GROQ_API_KEY=gsk_tu_groq_api_key_aqui

# Configuración opcional
DEFAULT_CLIENT=lla_chascomus
WHISPER_FALLBACK_MODEL=medium
